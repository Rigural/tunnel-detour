{
  "luci-app-tunnel-detour": {
    "description": "Manage Tunnel Detour",
    "read": {
      "ubus": {
        "uci": [ "get" ],
        "tunnel-detour": [ "status", "credentials_status", "validate", "inbound_status", "inbound_devices" ],
        "network.interface": [ "dump" ],
        "luci-rpc": [ "getDHCPLeases" ]
      },
      "uci": [ "tunnel-detour" ]
    },
    "write": {
      "ubus": { "tunnel-detour": [ "set_credentials", "check", "test_adguard", "preview_upstream", "restart", "check_inbound", "restart_inbound", "inbound_port_usage" ] },
      "uci": [ "tunnel-detour" ]
    }
  }
}
