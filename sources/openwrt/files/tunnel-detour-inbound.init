#!/bin/sh /etc/rc.common

START=96
STOP=9
USE_PROCD=1

start_service() {
	local enabled
	config_load tunnel-detour
	config_get_bool enabled inbound enabled 0
	[ "$enabled" -eq 1 ] || return 0
	procd_open_instance inbound
	procd_set_param command /usr/bin/tunnel-detour --inbound-uci
	procd_set_param file /usr/bin/tunnel-detour
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 90
	procd_set_param limits core="0" nofile="1024 1024"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	local enabled revocation_status=0
	config_load tunnel-detour
	config_get enabled inbound enabled ''
	[ -z "$enabled" ] || config_get_bool enabled inbound enabled 1
	if procd_running tunnel-detour-inbound inbound; then
		/usr/bin/tunnel-detour --queue-inbound-revocation || revocation_status=$?
	fi
	if [ "$enabled" = 0 ]; then
		stop
		# Keep configuration triggers registered so a later UCI enable can start us.
		start || return $?
		return "$revocation_status"
	elif procd_running tunnel-detour-inbound inbound; then
		procd_send_signal tunnel-detour-inbound inbound HUP || return $?
		return "$revocation_status"
	else
		start
	fi
}

service_stopped() {
	/usr/bin/tunnel-detour --cleanup-inbound
}

service_triggers() {
	local enabled lan wan
	config_load tunnel-detour
	config_get_bool enabled inbound enabled 0
	config_get lan inbound lan_network lan
	config_get wan inbound wan_network wan
	if [ "$enabled" -eq 1 ]; then
		# Keep revocation independent of the debounced policy reload.
		PROCD_RELOAD_DELAY=0 procd_add_config_trigger "config.change" tunnel-detour /usr/bin/tunnel-detour --queue-inbound-revocation
	fi
	procd_add_reload_trigger tunnel-detour
	procd_add_interface_trigger "interface.*" "$lan" /etc/init.d/tunnel-detour-inbound reload
	procd_add_interface_trigger "interface.*" "$wan" /etc/init.d/tunnel-detour-inbound reload
}
