#!/bin/sh /etc/rc.common

START=96
STOP=9
USE_PROCD=1

start_service() {
	local enabled
	config_load tunnel-detour
	config_get_bool enabled inbound enabled 0
	[ "$enabled" -eq 1 ] || return 0
	procd_open_instance inbound
	procd_set_param command /usr/bin/tunnel-detour --inbound-uci
	procd_set_param file /usr/bin/tunnel-detour
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 90
	procd_set_param limits core="0" nofile="1024 1024"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	local enabled
	config_load tunnel-detour
	config_get_bool enabled inbound enabled 0
	if [ "$enabled" -eq 0 ]; then
		stop
		# Keep configuration triggers registered so a later UCI enable can start us.
		start
	elif procd_running tunnel-detour-inbound inbound; then
		procd_send_signal tunnel-detour-inbound inbound HUP
	else
		start
	fi
}

service_stopped() {
	/usr/bin/tunnel-detour --cleanup-inbound
}

service_triggers() {
	local lan wan
	config_load tunnel-detour
	config_get lan inbound lan_network lan
	config_get wan inbound wan_network wan
	procd_add_reload_trigger tunnel-detour
	procd_add_interface_trigger "interface.*" "$lan" /etc/init.d/tunnel-detour-inbound reload
	procd_add_interface_trigger "interface.*" "$wan" /etc/init.d/tunnel-detour-inbound reload
}
