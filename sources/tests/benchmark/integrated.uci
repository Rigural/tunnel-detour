config globals 'globals'
	option enabled '0'
	option dns_integration 'dnsmasq'
	option lan_network 'lan'
	option wan_network 'wan'
	option dns_port '10535'
	option proxy_port '10536'
	option real_upstream '127.0.0.1:15353'
	option fake_range '198.18.0.0/24'
	option max_mappings '128'

config exception 'selected'
	option pattern 'selected.example.net'
	option enabled '1'

config inbound 'inbound'
	option enabled '0'
	option lan_network 'lan'
	option wan_network 'wan'
	option relay_connections '32'
	option relay_connect_timeout '5'
	option relay_idle_timeout '3600'

config inbound_port 'sample'
	option name 'Synthetic benchmark origin'
	option enabled '1'
	option protocol 'tcp'
	option public_port '18080'
	option destination_address '192.0.2.2'
	option destination_port '8080'
