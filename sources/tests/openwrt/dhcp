config dnsmasq 'main'
	option domainneeded '1'
	option boguspriv '1'
	option rebind_protection '1'
	option rebind_localhost '1'
	# Allow the isolated origin's reserved documentation addresses only for lab names.
	list rebind_domain 'example.net'
	option local '/lan/'
	option domain 'lan'
	option expandhosts '1'
	option noresolv '1'
	option localuse '0'
	option nonwildcard '1'
	option localservice '1'
	list server '127.0.0.1#15353'

config domain 'router'
	option name 'router.lan'
	option ip '192.0.2.1'
