#!/bin/sh /etc/rc.common

START=15
USE_PROCD=1

start_service() {
	ip link show tdlan0 >/dev/null 2>&1 || ip link add tdlan0 type dummy
	ip link show tdwan0 >/dev/null 2>&1 || ip link add tdwan0 type dummy
	ip link set tdlan0 up
	ip link set tdwan0 up
	procd_open_instance resolver
	procd_set_param command /usr/sbin/unbound -d -c /etc/tunnel-detour-lab-unbound.conf
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
